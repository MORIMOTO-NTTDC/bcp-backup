	<select id="selectInfoToppageList" resultMap="InfoWithFilesNotFileDataMap">
		<![CDATA[
		SELECT
		    infos._key
		    , infos.start_date
		    , infos.end_date
		    , infos.title
		    , infos.article
		    , infos.user_id
		    , users.user_name
		    , infos.update_date
		    , attachedfiles._key AS attachedfiles_key
		    , attachedfiles.info_key AS attachedfiles_info_key
		    , attachedfiles.file_name AS attachedfiles_file_name
		    , attachedfiles.update_date AS attachedfiles_update_date
		FROM
		    infos
		INNER JOIN
			users
		ON
			infos.user_id = users.user_id
		LEFT JOIN
			attachedfiles
		ON
			infos._key = attachedfiles.info_key
		WHERE
		    infos.start_date <= CURRENT_DATE
		    AND (CURRENT_DATE <= end_date OR end_date IS NULL)
		ORDER BY
		    infos.start_date DESC,
		    infos.end_date ASC,
		    infos._key ASC
		]]>
